# BrandSentinel AI Environment Variables

# ============================================
# API Configuration
# ============================================

# Google Gemini API Key (optional - system works without it)
GEMINI_API_KEY=

# Google Gemini Model (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter API Key (secondary AI provider fallback)
OPENROUTER_API_KEY=

# OpenRouter Model (Default: google/gemma-4-31b-it:free)
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Server Configuration
PORT=8000
CORS_ORIGINS=*

# Database
DATABASE_URL=sqlite:///./brandsentinel.sqlite

# ============================================
# File Upload Configuration
# ============================================

# Storage directory for uploaded documents (outside frontend public/dist)
# Default: ./uploads (relative to backend directory)
UPLOAD_STORAGE_ROOT=./uploads

# Maximum upload file size in megabytes
# Default: 10
UPLOAD_MAX_SIZE_MB=10

# Allowed file extensions (comma-separated, with dots)
# Default: .pdf,.docx,.doc,.txt
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.docx,.doc,.txt

# Allowed MIME types (comma-separated)
# Default: PDF, DOCX, legacy DOC, and plain text
UPLOAD_ALLOWED_MIMETYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,text/plain
